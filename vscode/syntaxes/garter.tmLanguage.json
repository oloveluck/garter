{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Garter",
  "scopeName": "source.garter",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.garter",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.garter",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.garter",
              "match": "\\\\[ntr\\\\\"']"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.garter",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.garter",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.garter",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.garter",
          "match": "\\b(if|else:|let|in|def|and|rec|lambda|match|begin|end|shadow)\\b|λ"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.garter",
          "match": "\\b(print|printStack|add1|sub1|isnum|isbool|istuple|input)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.garter",
          "match": "=>|:=|==|>=|<=|&&|\\|\\||[+\\-*/%><!;=]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.garter",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
