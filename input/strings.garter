def respond(msg):
  match msg:
    | "hello" => "Hi there!"
    | "bye" => "Goodbye!"
    | "thanks" => "You're welcome!"
    | _ => "I don't understand"

print("Hello, World!");

let greeting = "Welcome" in
let name = "Garter" in
print(greeting);
print(name);

print(respond("hello"));
print(respond("bye"));
print(respond("thanks"));
print(respond("xyz"));

let pname = "Alice" in
let age = 25 in
let job = "Engineer" in
print(pname);
print(age);
print(job);
"done"
