def make_counter_step(n):
  (n, (lambda (unused): make_counter_step(n + 1)))

let make_adder = (lambda (n): (lambda (x): x + n)) in

let compose = (lambda (f): (lambda (g): (lambda (x): f(g(x))))) in

let twice = (lambda (f): (lambda (x): f(f(x)))) in

let add5 = make_adder(5) in
let add10 = make_adder(10) in
let double = (lambda (x): x * 2) in
let square = (lambda (x): x * x) in

let double_after_add5 = compose(double)(add5) in

let quadruple = twice(double) in

let counter = make_counter_step(0) in
let count1 = counter[0] in
let counter2 = counter[1](0) in
let count2 = counter2[0] in
let counter3 = counter2[1](0) in
let count3 = counter3[0] in

(
  add5(10),
  add10(add5(0)),
  double_after_add5(3),
  quadruple(3),
  twice(square)(2),
  (count1, count2, count3)
)
