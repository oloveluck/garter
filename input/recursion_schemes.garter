def foldr(f, z, xs):
  match xs:
    | nil => z
    | (h, t) => f(h, foldr(f, z, t))

def foldl(f, z, xs):
  match xs:
    | nil => z
    | (h, t) => foldl(f, f(z, h), t)

def map(f, xs):
  match xs:
    | nil => nil
    | (h, t) => (f(h), map(f, t))

def filter(p, xs):
  match xs:
    | nil => nil
    | (h, t) =>
      if p(h): (h, filter(p, t))
      else: filter(p, t)

def unfold(done, step, seed):
  if done(seed): nil
  else:
    match step(seed):
      | (val, next) => (val, unfold(done, step, next))
      | _ => nil

def sum(xs): foldr((lambda (x, acc): x + acc), 0, xs)
def length(xs): foldl((lambda (acc, x): acc + 1), 0, xs)
def reverse(xs): foldl((lambda (acc, x): (x, acc)), nil, xs)
def append(xs, ys): foldr((lambda (x, acc): (x, acc)), ys, xs)

let nums = (1, (2, (3, (4, (5, nil))))) in

print("Recursion schemes demo");

print("sum:");
print(sum(nums));
print("length:");
print(length(nums));
print("reversed:");
print(reverse(nums));
print("doubled:");
print(map((lambda (x): x * 2), nums));
print("filtered > 2:");
print(filter((lambda (x): x > 2), nums));

let range = unfold(
  (lambda (n): n > 5),
  (lambda (n): (n, n + 1)),
  1) in
print("unfold range 1-5:");
print(range);
print("append:");
append(nums, (6, (7, nil)))
