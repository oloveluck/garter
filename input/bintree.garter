def size(t):
  match t:
    | nil => 0
    | (v, l, r) => 1 + size(l) + size(r)

def sum_tree(t):
  match t:
    | nil => 0
    | (v, l, r) => v + sum_tree(l) + sum_tree(r)

def max(a, b): if a > b: a else: b

def height(t):
  match t:
    | nil => 0
    | (v, l, r) => 1 + max(height(l), height(r))

def contains(t, x):
  match t:
    | nil => false
    | (v, l, r) =>
      if x == v: true
      else: if contains(l, x): true
      else: contains(r, x)

def append(l1, l2):
  match l1:
    | nil => l2
    | (h, t) => (h, append(t, l2))

def inorder(t):
  match t:
    | nil => nil
    | (v, l, r) => append(inorder(l), (v, inorder(r)))

let tree =
  (4,
    (2, (1, nil, nil), (3, nil, nil)),
    (6, (5, nil, nil), (7, nil, nil)))
in

print("Binary tree demo");
print("Size:");
print(size(tree));
print("Sum:");
print(sum_tree(tree));
print("Height:");
print(height(tree));
print("Contains 5?");
print(contains(tree, 5));
print("Contains 9?");
print(contains(tree, 9));
print("Inorder traversal:");
inorder(tree)
